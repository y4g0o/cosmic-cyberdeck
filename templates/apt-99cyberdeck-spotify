// cosmic-cyberdeck: after any apt run, give {{USUARIO}} write access to /usr/share/spotify/Apps again so Spicetify
// can re-apply the theme on login. Only Apps belongs to the user (the Spotify folder and binary stay root, 755),
// and nothing happens if Apps is a symlink (root never follows a link placed by the user).
// Generated by ativar-manutencao.sh into saida/. Install: sudo cp saida/apt-99cyberdeck-spotify /etc/apt/apt.conf.d/99cyberdeck-spotify
// Remove: sudo rm /etc/apt/apt.conf.d/99cyberdeck-spotify
DPkg::Post-Invoke { "S=/usr/share/spotify; if [ -d $S/Apps ] && [ ! -L $S/Apps ]; then chown -R -P {{USUARIO}}:{{USUARIO}} $S/Apps; chmod -R u+rwX,go-w $S/Apps; chmod 755 $S; fi"; };
