{
  "manifest_version": 3,
  "name": "cosmic-cyberdeck",
  "version": "1.0",
  "description": "cosmic-cyberdeck theme (generated from paletas/)",
  "theme": {
    "images": { "theme_ntp_background": "images/ntp.png" },
    "colors": {
      "frame": [{{rgb:fundo}}],
      "frame_inactive": [{{rgb:fundo_2}}],
      "toolbar": [{{rgb:sup_a}}],
      "tab_text": [{{rgb:accent}}],
      "tab_background_text": [{{rgb:muted}}],
      "tab_background_text_inactive": [{{rgb:fraco}}],
      "bookmark_text": [{{rgb:foco}}],
      "toolbar_text": [{{rgb:accent}}],
      "toolbar_button_icon": [{{rgb:accent}}],
      "omnibox_background": [{{rgb:fundo}}],
      "omnibox_text": [{{rgb:texto}}],
      "ntp_background": [{{rgb:fundo}}],
      "ntp_text": [{{rgb:accent}}],
      "ntp_link": [{{rgb:foco}}],
      "ntp_header": [{{rgb:alerta}}]
    },
    "properties": { "ntp_background_alignment": "center", "ntp_background_repeat": "no-repeat" }
  }
}
